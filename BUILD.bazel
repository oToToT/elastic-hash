load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "elastic_hash",
    hdrs = ["elastic_hash.hpp"],
)

cc_test(
    name = "elastic_hash_test",
    srcs = ["elastic_hash_test.cc"],
    deps = [
        ":elastic_hash",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "unordered_map_benchmark",
    srcs = ["unordered_map_benchmark.cc"],
    deps = [
        "@google_benchmark//:benchmark",
        ":elastic_hash",
    ],
)
cc_test(
    name = "elastic_hash_regression_test",
    srcs = ["elastic_hash_regression_test.cc"],
    deps = [":elastic_hash"],
    timeout = "short",
)
